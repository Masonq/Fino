{
  "expo": {
    "name": "PLONK",
    "slug": "plonk",
    "scheme": "plonk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF9",
    "ios": {
      "bundleIdentifier": "rs.plonk.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "rs.plonk.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 110,
          "backgroundColor": "#FAFAF9"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": "1",
    "updates": {
      "url": "https://plonk.rs/api/app-updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
