{
  "expo": {
    "name": "PLONK",
    "slug": "plonk",
    "scheme": "plonk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAF9",
    "ios": {
      "bundleIdentifier": "rs.plonk.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "rs.plonk.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF9"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 110,
          "backgroundColor": "#FAFAF9"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "PLONK берёт фото из галереи только для вашего объявления.",
          "cameraPermission": "PLONK открывает камеру, чтобы вы сфотографировали вещь для объявления.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PLONK определяет ваш город, чтобы показать объявления рядом. Координаты никуда не отправляются."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": "4",
    "updates": {
      "url": "https://plonk.rs/api/app-updates/manifest",
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
