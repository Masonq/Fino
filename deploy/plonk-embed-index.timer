[Unit]
Description=Каждые 10 минут — векторы для новых объявлений (поиск по смыслу)

[Timer]
# по часам, а не «через 10 минут после прошлого запуска»: тот вариант не срабатывает, пока задача ни разу
# не отработала после включения таймера
OnCalendar=*:0/10
Persistent=false

[Install]
WantedBy=timers.target
