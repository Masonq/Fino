[Unit]
Description=Раз в сутки утром шлёт сотрудникам сводку по очереди и тревогам

[Timer]
# 9 утра по Белграду. Сводка нужна к началу дня, а не ночью: ночное
# сообщение либо разбудит, либо потеряется среди прочего до утра.
OnCalendar=*-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
