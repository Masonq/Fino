[Unit]
Description=Проверяет, не появилось ли нового по сохранённым поискам

[Timer]
# Каждые три часа. Чаще незачем: сам скрипт всё равно не пишет человеку
# чаще раза в сутки на один поиск, а объявления не появляются
# посекундно — за три часа накопится ровно то, что стоит показать.
#
# Ночью тоже: уведомление придёт в Telegram, где человек сам решает,
# когда его прочесть, а придержать до утра значит опоздать с вещью,
# которую разберут за день.
OnCalendar=*-*-* 0/3:00:00
Persistent=true

[Install]
WantedBy=timers.target
