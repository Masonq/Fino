[Unit]
Description=Раз в сутки убирает из ленты повторы, которые прошли мимо отсева на входе

[Timer]
# Ночью: работа идёт по всей ленте объявлений, а под утро активность
# людей минимальная. Чаще раза в сутки незачем — повторы копятся
# медленно, а отсев при переносе ловит большинство сразу на входе.
OnCalendar=*-*-* 04:30:00
Persistent=true

[Install]
WantedBy=timers.target
