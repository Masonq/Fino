[Unit]
Description=PLONK — обновление цен нового товара по страницам магазинов
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/fino/backend
# Не чаще раза в неделю, по одному запросу на страницу, только туда, куда
# пускает robots.txt (см. app/core/price_refs.py).
ExecStart=/opt/fino/backend/venv/bin/python3 -m app.core.price_refs refresh --apply
User=root
