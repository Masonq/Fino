[Unit]
Description=Каждый час доводит объявления до трёх языков

[Timer]
# Раз в час, а не раз в сутки. Ночная уборка делала один заход и
# упиралась в дневной запас бесплатных тарифов; за сутки выходило
# полтора десятка объявлений при четырёх тысячах в ленте. Двадцать
# четыре захода в сутки берут тот же запас равномерно, а заодно
# переживают временную недоступность переводчика: следующий заход
# через час.
# С двух часов ночи, а не с полуночи: первые полтора часа после
# обновления суточного запаса отданы уборке ленты
# (plonk-cleanup.timer). Иначе перевод, работающий каждый час,
# выбирал весь запас, и уборка не делала ни одного обращения.
OnCalendar=*-*-* 02..23:25:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
