[Unit]
Description=Раз в сутки: набрать полсотни объявлений, прибрать и перевести

[Timer]
# 07:30 UTC — через полчаса после того, как у Gemini обновляется
# суточный запас (он считается по тихоокеанскому времени, полночь там
# это 07:00 UTC летом). Прежние ночные запуски приходили к пустому
# запасу: по UTC была ночь, а по тихоокеанскому — середина суток.
OnCalendar=*-*-* 07:30:00
Persistent=true

[Install]
WantedBy=timers.target
