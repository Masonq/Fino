[Unit]
Description=Раз в несколько часов проверяет непрочитанное молчание в переписках

[Timer]
# Каждые 6 часов — молчание считается «долгим» через 24 часа (см.
# SILENCE_HOURS в reply_reminder.py), четыре раза в сутки достаточно
# часто, чтобы напоминание пришло не сильно позже самого порога, и
# не настолько часто, чтобы гонять запрос по всей базе переписок
# каждые несколько минут.
OnCalendar=*-*-* 0/6:00:00
Persistent=true

[Install]
WantedBy=timers.target
