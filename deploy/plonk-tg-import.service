[Unit]
Description=PLONK: перенос объявлений из чатов
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/fino/backend
ExecStart=/opt/fino/backend/venv/bin/python3 -m app.core.tg_import --since-last --days 3
User=root

# Ограничение по времени — главное здесь.
#
# Заход однажды простоял мёртвым трое суток: библиотека Telegram ждала
# ответа, своего срока ожидания у неё нет, и процесс просто стоял.
# Заодно он держал файл сессии, поэтому ни один следующий заход
# запуститься не мог — лента не пополнялась вовсе, и заметили это
# только по жалобе.
#
# Полчаса с запасом хватает: обычный заход укладывается в несколько
# минут. Что не успело — приедет следующим разом, метка прочитанного
# сохраняется по каждому чату отдельно.
TimeoutStartSec=1800
KillMode=mixed
