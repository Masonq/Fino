[Unit]
Description=Восемь раз в день отправляет объявление с сайта в чат

[Timer]
# Каждые полтора часа с десяти утра до половины девятого вечера —
# восемь постов в сутки. Прежние десять минут давали под восемьдесят:
# столько не выдерживает ни один канал, люди отключают уведомления, а
# потом отписываются. Восемь — лента, которую успевают посмотреть.
#
# Двумя строками, а не одной: шаг в девяносто минут через дробь
# записать нельзя — в systemd дробь для минут работает внутри часа, а
# минут больше пятидесяти девяти не бывает. Поэтому чётные заходы в
# начале часа, нечётные — в половине.
OnCalendar=*-*-* 10,13,16,19:00:00
OnCalendar=*-*-* 11,14,17,20:30:00
Persistent=false

[Install]
WantedBy=timers.target
