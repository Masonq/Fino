[Unit]
Description=Каждые десять минут отправляет объявление с сайта в чат

[Timer]
# Каждые десять минут по одному объявлению. Пачками постить нельзя:
# пять сообщений подряд читаются как реклама, и от такого отписываются.
# По одному раз в десять минут лента чата выглядит живой, а не
# рассылкой. Ночью молчим — уведомление в три часа будит людей.
OnCalendar=*-*-* 09..22:00/10
Persistent=false

[Install]
WantedBy=timers.target
