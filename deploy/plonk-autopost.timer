[Unit]
Description=Каждые десять минут отправляет объявление с сайта в чат

[Timer]
# Каждые десять минут по одному объявлению. Пачками постить нельзя:
# пять сообщений подряд читаются как реклама, и от такого отписываются.
# По одному раз в десять минут лента чата выглядит живой, а не
# рассылкой. Ночью молчим — уведомление в три часа будит людей.
# Каждые полтора часа с десяти утра до девяти вечера — восемь постов в
# сутки. Прежние десять минут давали под восемьдесят: столько не
# выдерживает ни один канал, люди просто отключают уведомления, а
# потом и отписываются. Восемь — это лента, которую успевают
# посмотреть, и её хватает, чтобы канал выглядел живым.
OnCalendar=*-*-* 10..21:00/90
Persistent=false

[Install]
WantedBy=timers.target
