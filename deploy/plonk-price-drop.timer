[Unit]
Description=Проверяет, не подешевело ли отложенное в избранное

[Timer]
# Дважды в сутки. Скидка не портится: вещь, подешевевшая утром, будет
# дешёвой и вечером — гнать проверку по всей базе избранного каждый час
# незачем.
OnCalendar=*-*-* 10,19:00:00
Persistent=true

[Install]
WantedBy=timers.target
