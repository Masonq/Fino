[Unit]
Description=Раз в сутки утром рассказывает, что нашлось по сохранённым поискам

[Timer]
# Девять утра: человек берёт телефон, едет или пьёт кофе — и у него
# есть минута посмотреть, что появилось. Ночью слать нельзя, днём он
# занят, вечером отложит до завтра и забудет.
OnCalendar=*-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
