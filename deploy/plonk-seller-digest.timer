[Unit]
Description=Раз в неделю рассказывает продавцам, что было с их объявлениями

[Timer]
# Вторник, одиннадцать утра. Не понедельник: в начале недели человек
# разгребает своё и чужие сообщения читает вполглаза. Не вечер: вещь,
# о которой ему напомнили, хочется поправить сразу, а вечером он
# отложит до завтра и забудет.
OnCalendar=Tue *-*-* 11:00:00
Persistent=true

[Install]
WantedBy=timers.target
