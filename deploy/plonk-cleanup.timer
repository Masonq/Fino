[Unit]
Description=Каждую ночь разбирает заголовки и описания в ленте

[Timer]
# Полпервого ночи по UTC — сразу после того, как у провайдеров
# обновляется суточный запас (у всех четырёх он считается по UTC).
# Раньше уборка шла днём и не заставала ни одного обращения: перевод,
# работающий каждый час, выбирал весь запас к утру.
#
# Перевод в это время молчит (см. plonk-translate.timer — он начинает
# в два часа), так что первые полтора часа после сброса принадлежат
# уборке.
OnCalendar=*-*-* 00:30:00
Persistent=true

[Install]
WantedBy=timers.target
