[Unit]
Description=Раз в три часа забирает из чатов новые объявления

[Timer]
# Раз в три часа. Каждый час — лишнее: объявления в чатах появляются
# не так быстро, а каждый заход это работа модерации, которую потом
# кто-то разбирает. Три часа — четыре-пять заходов в день, по десятку
# объявлений, столько разбирается за раз без усталости.
OnCalendar=*-*-* 0/3:20:00
Persistent=true

[Install]
WantedBy=timers.target
