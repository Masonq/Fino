[Unit]
Description=Каждый час забирает из чатов новые объявления

[Timer]
# Раз в час: чаще незачем — объявления в чатах появляются не пачками, а
# Telegram при частых обращениях просит подождать. Реже — лента
# заметно отстаёт от чатов, ради свежести её и делают.
OnCalendar=*-*-* *:15:00
# Пропущенный заход (сервер был выключен) наверстываем: иначе провал в
# ленте останется навсегда — метка прочитанного сдвинется только после
# успешного захода.
Persistent=true
# Разброс, чтобы все службы не стартовали в одну секунду.
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
