[Unit]
Description=Раз в сутки обновляет курс рубля к динару

[Timer]
# Раннее утро: к моменту, когда люди начнут пополнять баланс, курс уже
# свежий. Persistent — чтобы после перезагрузки сервер не остался со
# вчерашним курсом до следующего утра.
OnCalendar=*-*-* 06:10:00
Persistent=true

[Install]
WantedBy=timers.target
