# Настройки сборки для боевого сайта. Файл в репозитории намеренно:
# всё, что попадает в VITE_*, всё равно уезжает в браузер и секретом
# быть не может — идентификатор приложения Google публичный по своей
# природе, подлинность входа проверяется на сервере по подписи токена.

# Пусто — значит адрес API берётся относительным (/api), как и нужно,
# когда фронт и бэкенд за одним nginx.
VITE_API_BASE=

# Вход через Google. Тот же идентификатор должен стоять в GOOGLE_CLIENT_ID
# на сервере — иначе сервер отвергнет токен как выписанный чужому
# приложению.
VITE_GOOGLE_CLIENT_ID=213564903711-537h788s1686d0apnsefp7r2d4u9l7b3.apps.googleusercontent.com
